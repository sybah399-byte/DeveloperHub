{
  "name": "developerhub",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "devhub": "concurrently -k \"npm run dev\" \"npx wait-on http://127.0.0.1:5173 && npm run electron\"",
    "start": "npm run devhub"
  },
