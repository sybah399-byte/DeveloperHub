    "cross-spawn": "^7.0.6",
    "electron-store": "^11.0.2",
    "eslint": "^10.8.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "listr2": "^11.0.0",
    "lucide-react": "^1.28.0",
    "ora": "^9.4.1",
    "prettier": "^3.9.6",
    "react": "latest",
    "react-dom": "latest",
    "react-hot-toast": "^2.6.0",
